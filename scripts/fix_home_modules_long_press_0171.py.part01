hortcutSpec(
        id = id,
        emoji = "⚡",
        label = "Rota",
        action = BubbleShortcutAction.OpenRoute,
        doubleTapAction = secondary,
    )

    @Test
    fun defaultPreservesExistingSecondaryBehavior() {
        val withSecondary = spec(BubbleShortcutQuickAction.DefineDestinationAtCurrentLocation)
        assertEquals(
            ShortcutLongPressResolved0171.Secondary,
            ShortcutLongPressPolicy0171.resolve(withSecondary, ShortcutLongPressChoice0171.PreserveExisting),
        )
    }

    @Test
    fun defaultPreservesExistingPrimaryFallback() {
        assertEquals(
            ShortcutLongPressResolved0171.Primary,
            ShortcutLongPressPolicy0171.resolve(spec(), ShortcutLongPressChoice0171.PreserveExisting),
        )
    }

    @Test
    fun secondaryChoiceIsUnavailableWithoutSecondaryAction() {
        val plain = spec()
        assertFalse(ShortcutLongPressPolicy0171.availableChoices(plain).contains(ShortcutLongPressChoice0171.RunSecondary))
        assertEquals(
            ShortcutLongPressResolved0171.None,
            ShortcutLongPressPolicy0171.resolve(plain, ShortcutLongPressChoice0171.RunSecondary),
        )
    }

    @Test
    fun sensitiveAndSecondaryActionsRequireConfirmation() {
        assertTrue(
            ShortcutLongPressPolicy0171.requiresConfirmation(
                spec(id = "stop_app"),
                ShortcutLongPressChoice0171.RunPrimary,
                ShortcutLongPressResolved0171.Primary,
            ),
        )
        assertTrue(
            ShortcutLongPressPolicy0171.requiresConfirmation(
                spec(BubbleShortcutQuickAction.CreateQuickReply),
                ShortcutLongPressChoice0171.RunSecondary,
                ShortcutLongPressResolved0171.Secondary,
            ),
        )
        assertFalse(
            ShortcutLongPressPolicy0171.requiresConfirmation(
                spec(),
                ShortcutLongPressChoice0171.OpenModule,
                ShortcutLongPressResolved0171.OpenModule,
            ),
        )
        assertFalse(
            ShortcutLongPressPolicy0171.requiresConfirmation(
                spec(id = "stop_app"),
                ShortcutLongPressChoice0171.PreserveExisting,
                ShortcutLongPressResolved0171.Primary,
            ),
        )
    }
}
'''

CONTRACT_TEST_KOTLIN = r'''package br.com.mapeiaia.rotacerta

import java.io.File
import org.junit.Assert.assertFalse
import org.junit.Assert.assertTrue
import org.junit.Test

class ShortcutLongPressContract0171Test {
    private val main = File("src/main/java/br/com/mapeiaia/rotacerta/MainActivity.kt").readText()
    private val service = File("src/main/java/br/com/mapeiaia/rotacerta/LiveRideAccessibilityService.kt").readText()
    private val overlay = File("src/main/java/br/com/mapeiaia/rotacerta/BubbleShortcutOverlayController.kt").readText()

    @Test
    fun allModulesAreAvailableFromHome() {
        assertTrue(main.contains("ShortcutModulesHome0171"))
        assertTrue(main.contains("BubbleShortcutCatalog.modules.forEach"))
        assertTrue(main.contains("Ação ao manter pressionado o atalho"))
    }

    @Test
    fun overlayDelegatesLongPressWithoutImplicitFallback() {
        assertTrue(overlay.contains("onShortcutLongPress"))
        assertFalse(overlay.contains("(doubleAction ?: singleAction).invoke()"))
        assertTrue(service.contains("executeShortcutLongPress0171"))
        assertTrue(service.contains("ShortcutLongPressPreferenceStore0171"))
    }

    @Test
    fun sensitiveLongPressHasConfirmationPath() {
        assertTrue(overlay.contains("showShortcutConfirmation0171"))
        assertTrue(service.contains("requiresConfirmation"))
        assertTrue(service.contains("openShortcutModule0171"))
    }
}
'''

