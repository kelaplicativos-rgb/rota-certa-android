                        }
                    }
                },
                confirmButton = {},
                dismissButton = {
                    TextButton(onClick = { pendingGestureSlot0180 = null }) { Text("Voltar") }
                },
            )
        }
    }

    pendingGestureMenuEntryId0180?.let { entryId0180 ->
