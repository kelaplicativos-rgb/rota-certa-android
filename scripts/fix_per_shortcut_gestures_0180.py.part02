    fun updateEntryAndPersist0180(
        entryId0180: String,
        transform0180: (ShortcutGridEntry0179) -> ShortcutGridEntry0179,
    ) {
        val index0180 = entries0179.indexOfFirst { it.entryId == entryId0180 }
        if (index0180 < 0) return
        entries0179[index0180] = transform0180(entries0179[index0180])
        save0179(showToast = false)
    }

    pendingGestureSlot0180?.let { slot0180 ->
        val entryId0180 = pendingGestureMenuEntryId0180
        val item0180 = entries0179.firstOrNull { it.entryId == entryId0180 }
        if (entryId0180 == null || item0180 == null) {
            pendingGestureSlot0180 = null
        } else {
            AlertDialog(
                onDismissRequest = { pendingGestureSlot0180 = null },
                title = {
                    Text(if (slot0180 == ShortcutGestureSlot0180.QUICK_TAP) "Um toque rápido" else "Toque de 1,5 segundo")
                },
                text = {
                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                        Text("Escolha o que a bolinha ${item0180.label} deve fazer neste gesto.")
                        ShortcutGestureAction0180.values().forEach { action0180 ->
                            OutlinedButton(
                                onClick = {
                                    updateEntryAndPersist0180(entryId0180) { current0180 ->
                                        when (slot0180) {
