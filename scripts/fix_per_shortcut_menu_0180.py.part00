)

object ShortcutGesturePolicy0179 {
    const val SHORTCUT_LONG_PRESS_MILLIS: Long = 2_000L
    const val MAIN_CUSTOMIZATION_HOLD_MILLIS: Long = 5_000L""",
    """enum class ShortcutGestureAction0180(val displayLabel: String) {
    PRIMARY_ACTION("Executar ação imediatamente"),
    OPEN_MODULE("Abrir módulo"),
    NONE("Não fazer nada"),
}

enum class ShortcutGestureSlot0180(val displayLabel: String) {
    QUICK_TAP("Toque rápido"),
    HOLD_1500("Segurar 1,5 segundo"),
}

data class ShortcutGridEntry0179(
    val entryId: String,
    val shortcutId: String,
    val label: String,
    val emoji: String,
    val enabled: Boolean = true,
    val quickAction0180: ShortcutGestureAction0180 = ShortcutGestureAction0180.PRIMARY_ACTION,
    val holdAction0180: ShortcutGestureAction0180 = ShortcutGestureAction0180.OPEN_MODULE,
)

data class ResolvedShortcutGridEntry0179(
    val entryId: String,
    val shortcutId: String,
    val spec: BubbleShortcutSpec,
    val quickAction0180: ShortcutGestureAction0180,
    val holdAction0180: ShortcutGestureAction0180,
)

object ShortcutGesturePolicy0179 {
    const val SHORTCUT_LONG_PRESS_MILLIS: Long = 1_500L
    const val SHORTCUT_CUSTOMIZATION_HOLD_MILLIS: Long = 5_000L
    const val MAIN_CUSTOMIZATION_HOLD_MILLIS: Long = 5_000L""",
)
replace_once(
    customization,
    """                ResolvedShortcutGridEntry0179(
                    entryId = entry.entryId,
                    spec = original.copy(
                        emoji = entry.emoji,
                        label = entry.label,
                        displayLabel = entry.label,
                    ),
                )""",
    """                ResolvedShortcutGridEntry0179(
                    entryId = entry.entryId,
                    shortcutId = entry.shortcutId,
                    spec = original.copy(
                        emoji = entry.emoji,
                        label = entry.label,
                        displayLabel = entry.label,
                    ),
                    quickAction0180 = entry.quickAction0180,
                    holdAction0180 = entry.holdAction0180,
                )""",
)
replace_once(
    customization,
    """                            emoji = item.optString("emoji"),
                            enabled = item.optBoolean("enabled", true),
                        ),""",
    """                            emoji = item.optString("emoji"),
                            enabled = item.optBoolean("enabled", true),
                            quickAction0180 = parseGestureAction0180(
                                item.optString("quickAction0180"),
                                ShortcutGestureAction0180.PRIMARY_ACTION,
                            ),
                            holdAction0180 = parseGestureAction0180(
                                item.optString("holdAction0180"),
                                ShortcutGestureAction0180.OPEN_MODULE,
                            ),
                        ),""",
)
replace_once(
    customization,
    """                    .put("emoji", entry.emoji)
                    .put("enabled", entry.enabled),""",
    """                    .put("emoji", entry.emoji)
                    .put("enabled", entry.enabled)
                    .put("quickAction0180", entry.quickAction0180.name)
                    .put("holdAction0180", entry.holdAction0180.name),""",
)
replace_once(
    customization,
    """    fun reset() {
        prefs.edit().remove(KEY_GRID).apply()
    }

    private companion object {""",
    """    fun reset() {
        prefs.edit().remove(KEY_GRID).apply()
    }

    private fun parseGestureAction0180(
        raw: String,
        fallback: ShortcutGestureAction0180,
    ): ShortcutGestureAction0180 = runCatching {
        ShortcutGestureAction0180.valueOf(raw)
    }.getOrDefault(fallback)

    private companion object {""",
