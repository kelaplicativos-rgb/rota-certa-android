with_marker = read(customization)
if MARKER not in with_marker:
    write(customization, with_marker + f"\n// {MARKER}\n")

# Overlay: quick action on release before 1.5 s, hold action on release between
# 1.5 and 5 s, and individual editor exactly at 5 s. This prevents the 1.5 s
# action from firing before a user reaches the five-second configuration gesture.
overlay = "app/src/main/java/br/com/mapeiaia/rotacerta/BubbleShortcutOverlayController.kt"
replace_all_exact(
    overlay,
    """        onShortcut: (BubbleShortcutSpec) -> Unit,
