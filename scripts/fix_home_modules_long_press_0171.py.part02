    '''    private fun executeShortcutLongPress0171(spec: BubbleShortcutSpec) {
        val choice0171 = shortcutLongPressStore0171.read(spec.id)
        val resolved0171 = ShortcutLongPressPolicy0171.resolve(spec, choice0171)
        UnifiedDebugEventStore.record(
            "SHORTCUT_LONG_PRESS_0171",
            universalResolvedForegroundPackage(),
            "id=${spec.id}; choice=${choice0171.name}; resolved=${resolved0171.name}",
        )
        if (resolved0171 == ShortcutLongPressResolved0171.None) {
            shortcutOverlayController.showSilentStatus159("Toque longo sem ação para ${spec.displayLabel}", true)
            return
        }
        if (ShortcutLongPressPolicy0171.requiresConfirmation(spec, choice0171, resolved0171)) {
            shortcutOverlayController.showShortcutConfirmation0171(
                title = spec.displayLabel,
                detail = "Confirmar: ${ShortcutLongPressPolicy0171.resolvedLabel(spec, resolved0171)}?",
                onConfirm = { executeResolvedLongPress0171(spec, resolved0171) },
            )
            return
        }
        executeResolvedLongPress0171(spec, resolved0171)
    }

    private fun executeResolvedLongPress0171(
        spec: BubbleShortcutSpec,
        resolved0171: ShortcutLongPressResolved0171,
    ) {
        when (resolved0171) {
            ShortcutLongPressResolved0171.None -> Unit
            ShortcutLongPressResolved0171.OpenModule -> openShortcutModule0171(spec)
            ShortcutLongPressResolved0171.Primary -> executeShortcutModule(spec)
            ShortcutLongPressResolved0171.Secondary -> executeShortcutDoubleTap(spec)
        }
    }

    private fun openShortcutModule0171(spec: BubbleShortcutSpec) {
        shortcutOverlayController.hideAll()
        persistResourceShortcutState()
