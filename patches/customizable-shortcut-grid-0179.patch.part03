+        val defaults = ShortcutGridCustomizationPolicy0179.defaults()
+        val disabled = defaults.first().copy(enabled = false)
+        val resolved = ShortcutGridCustomizationPolicy0179.resolve(listOf(disabled) + defaults.drop(1))
+        assertFalse(resolved.any { it.entryId == disabled.entryId })
+        assertEquals(defaults.size - 1, resolved.size)
+    }
+
+    @Test
+    fun customNameAndIconDoNotChangeTheSafeCatalogAction() {
+        val original = ShortcutGridCustomizationPolicy0179.defaults().first()
+        val resolved = ShortcutGridCustomizationPolicy0179.resolve(
+            listOf(original.copy(label = "Minha rota", emoji = "⭐")),
+        ).single().spec
+        assertEquals("Minha rota", resolved.displayLabel)
+        assertEquals("⭐", resolved.emoji)
+        assertEquals(BubbleShortcutCatalog.findSpec(original.shortcutId)?.action, resolved.action)
+        assertEquals(original.shortcutId, resolved.id)
+    }
+
+    @Test
+    fun addMoveAndMaximumAreDeterministic() {
+        val start = ShortcutGridCustomizationPolicy0179.defaults().take(2)
+        val added = ShortcutGridCustomizationPolicy0179.add(start, "radars", 123L)
+        assertEquals(3, added.size)
+        assertEquals("radars", added.last().shortcutId)
+        val moved = ShortcutGridCustomizationPolicy0179.move(added, 2, 0)
+        assertEquals("radars", moved.first().shortcutId)
+        val oversized = (0 until 40).map { index ->
+            start.first().copy(entryId = "entry-$index")
+        }
+        assertEquals(ShortcutGesturePolicy0179.MAX_GRID_ITEMS, ShortcutGridCustomizationPolicy0179.normalize(oversized).size)
+    }
+
+    @Test
+    fun gestureDurationsMatchTheUserContract() {
+        assertEquals(2_000L, ShortcutGesturePolicy0179.SHORTCUT_LONG_PRESS_MILLIS)
+        assertEquals(5_000L, ShortcutGesturePolicy0179.MAIN_CUSTOMIZATION_HOLD_MILLIS)
+    }
+}
