new file mode 100644
index 0000000..623912b
--- /dev/null
+++ b/app/src/test/java/br/com/mapeiaia/rotacerta/ShortcutGridCustomizationContract0179Test.kt
@@ -0,0 +1,48 @@
+package br.com.mapeiaia.rotacerta
+
+import java.io.File
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ShortcutGridCustomizationContract0179Test {
+    private val main = File("src/main/java/br/com/mapeiaia/rotacerta/MainActivity.kt").readText()
+    private val service = File("src/main/java/br/com/mapeiaia/rotacerta/LiveRideAccessibilityService.kt").readText()
+    private val overlay = File("src/main/java/br/com/mapeiaia/rotacerta/BubbleShortcutOverlayController.kt").readText()
+    private val store = File("src/main/java/br/com/mapeiaia/rotacerta/ShortcutGridCustomization0179.kt").readText()
+
+    @Test
+    fun plusAndCentralAreConnectedWithoutNewActivity() {
+        assertTrue(overlay.contains("shortcut_add_0179"))
+        assertTrue(overlay.contains("onCustomize"))
+        assertTrue(service.contains("EXTRA_OPEN_SHORTCUT_CUSTOMIZATION_0179"))
+        assertTrue(main.contains("ShortcutGridCustomizationScreen0179"))
+        assertTrue(main.contains("Central de atalhos da grade flutuante"))
+    }
+
+    @Test
+    fun mainFiveSecondHoldCancelsWhenDraggingAndDoesNotReplaceNormalTap() {
+        assertTrue(service.contains("mainHoldHandler0179.postDelayed"))
+        assertTrue(service.contains("MAIN_CUSTOMIZATION_HOLD_MILLIS"))
+        assertTrue(service.contains("mainHoldHandler0179.removeCallbacks"))
+        assertTrue(service.contains("newView.setOnClickListener { toggleResourceShortcuts() }"))
+    }
+
+    @Test
+    fun shortAndLongGesturesHaveSeparateDeterministicActions() {
+        assertTrue(overlay.contains("SHORTCUT_LONG_PRESS_MILLIS"))
+        assertTrue(service.contains("onShortcut = ::executeShortcutModule"))
+        assertTrue(service.contains("onShortcutLongPress = ::executeShortcutLongPress0179"))
+        assertTrue(service.contains("openShortcutModule0171(spec)"))
+        assertFalse(service.contains("private fun executeShortcutLongPress0173"))
+    }
+
+    @Test
+    fun persistenceIsBoundedAndReferencesOnlyCatalogActions() {
+        assertTrue(store.contains("MAX_GRID_ITEMS"))
+        assertTrue(store.contains("BubbleShortcutCatalog.findSpec"))
+        assertTrue(store.contains("JSONArray"))
+        assertFalse(store.contains("Intent.parseUri"))
+        assertFalse(store.contains("PackageManager"))
+    }
+}
