+package br.com.mapeiaia.rotacerta
+
+import android.view.MotionEvent
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ShortcutGridBackdropPolicy0186Test {
+    @Test
+    fun actionDownClosesImmediately() {
+        assertTrue(ShortcutGridBackdropPolicy0186.shouldDismiss(MotionEvent.ACTION_DOWN))
+    }
+
+    @Test
+    fun laterEventsDoNotRequestAnotherClose() {
+        assertFalse(ShortcutGridBackdropPolicy0186.shouldDismiss(MotionEvent.ACTION_MOVE))
+        assertFalse(ShortcutGridBackdropPolicy0186.shouldDismiss(MotionEvent.ACTION_UP))
+        assertFalse(ShortcutGridBackdropPolicy0186.shouldDismiss(MotionEvent.ACTION_CANCEL))
+        assertFalse(ShortcutGridBackdropPolicy0186.shouldDismiss(MotionEvent.ACTION_OUTSIDE))
+    }
+}
