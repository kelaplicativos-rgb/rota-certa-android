+package br.com.mapeiaia.rotacerta
+
+import java.io.File
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ShortcutGridBackdropContract0186Test {
+    private val overlay = File(
+        "src/main/java/br/com/mapeiaia/rotacerta/BubbleShortcutOverlayController.kt",
+    ).readText()
+    private val toggleShortcuts = overlay.substringAfter("fun toggleShortcuts(")
+        .substringBefore("fun hideShortcuts()")
+    private val hideShortcuts = overlay.substringAfter("fun hideShortcuts()")
+        .substringBefore("fun showProximityAlert(")
+    private val showShortcuts = overlay.substringAfter("private fun showShortcuts(")
+        .substringBefore("private fun shortcutBubble(")
+    private val backdropBlock = showShortcuts.substringAfter("val backdrop = FrameLayout(context)")
+        .substringBefore("val params = WindowManager.LayoutParams(")
+
+    @Test
+    fun gridUsesFullScreenTouchOwningBackdrop() {
+        assertTrue(showShortcuts.contains("SHORTCUT_GRID_BACKDROP_DISMISS_0186"))
+        assertTrue(showShortcuts.contains("val backdrop = FrameLayout(context)"))
+        assertTrue(showShortcuts.contains("WindowManager.LayoutParams.MATCH_PARENT"))
+        assertTrue(showShortcuts.contains("windowManager.addView(backdrop, params)"))
+        assertTrue(showShortcuts.contains("shortcutView = backdrop"))
+    }
+
+    @Test
+    fun outsideDownClosesAndConsumesWithoutPassThroughFlags() {
+        assertTrue(backdropBlock.contains("ShortcutGridBackdropPolicy0186.shouldDismiss(event.actionMasked)"))
+        assertTrue(backdropBlock.contains("hideShortcuts()"))
+        assertTrue(backdropBlock.trimEnd().endsWith("}"))
+        assertTrue(backdropBlock.contains("true"))
+        assertFalse(showShortcuts.contains("FLAG_NOT_TOUCH_MODAL"))
+        assertFalse(showShortcuts.contains("FLAG_WATCH_OUTSIDE_TOUCH"))
+        assertFalse(showShortcuts.contains("MotionEvent.ACTION_OUTSIDE"))
+    }
+
+    @Test
+    fun panelKeepsItsOwnTouchTargetAndAccessibilityChildren() {
+        assertTrue(showShortcuts.contains("menu.isClickable = true"))
+        assertTrue(showShortcuts.contains("addView(\n                menu,"))
+        assertTrue(showShortcuts.contains("View.IMPORTANT_FOR_ACCESSIBILITY_NO"))
+        assertFalse(showShortcuts.contains("IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS"))
+    }
+
+    @Test
+    fun panelKeepsPositionPolicyAndEdgePlacement() {
+        assertTrue(showShortcuts.contains("BubbleShortcutPositionPolicy.place("))
+        assertTrue(showShortcuts.contains("leftMargin = position.x"))
+        assertTrue(showShortcuts.contains("topMargin = position.y"))
+        assertTrue(showShortcuts.contains("WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE"))
+    }
+
+    @Test
+    fun tappingMainBubbleAreaWhileOpenUsesExistingToggleClosePath() {
+        assertTrue(toggleShortcuts.contains("if (shortcutView != null)"))
+        assertTrue(toggleShortcuts.contains("hideShortcuts()"))
+        assertTrue(toggleShortcuts.contains("showShortcuts("))
+    }
+
+    @Test
+    fun backdropNeverDispatchesShortcutOrFarolActions() {
+        assertFalse(backdropBlock.contains("onShortcut("))
+        assertFalse(backdropBlock.contains("onShortcutLongPress("))
+        assertFalse(backdropBlock.contains("onShortcutCustomize("))
+        assertFalse(backdropBlock.contains("DecisionEngine"))
+        assertFalse(backdropBlock.contains("GoogleMapsService"))
+        assertFalse(backdropBlock.contains("RideTextParser"))
+    }
+
+    @Test
+    fun closeRemainsIdempotent() {
+        assertTrue(hideShortcuts.contains("val view = shortcutView ?: return"))
+        assertTrue(hideShortcuts.contains("windowManager.removeView(view)"))
+        assertTrue(hideShortcuts.contains("shortcutView = null"))
+    }
+
+    @Test
+    fun shortcutTouchAndDragHandlingRemainPresent() {
+        assertTrue(overlay.contains("SHORTCUT_DIRECT_TAP_0182"))
+        assertTrue(overlay.contains("MotionEvent.ACTION_MOVE"))
+        assertTrue(overlay.contains("movedOutsideGesture = true"))
+        assertTrue(overlay.contains("singleAction()"))
+    }
+}
