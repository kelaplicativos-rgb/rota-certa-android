+package br.com.mapeiaia.rotacerta
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ShortcutGridCustomization0179Test {
+    @Test
+    fun defaultsPreserveCurrentCatalogOrderAndActions() {
+        val defaults = ShortcutGridCustomizationPolicy0179.defaults()
+        assertEquals(BubbleShortcutCatalog.modules.size, defaults.size)
+        assertEquals(BubbleShortcutCatalog.modules.map { it.spec.id }, defaults.map { it.shortcutId })
+        assertTrue(defaults.all { it.enabled })
+    }
+
+    @Test
+    fun disabledEntriesAreNotRenderedButRemainEditable() {
