        val candidateSource: String?,
        val lastCandidateRawRevision: Long,
    ) {
        val candidateBound: Boolean get() = !destinationKey.isNullOrBlank()
        val identityHash: Long get() = stableHash64("lease=$leaseId|act=$activationGeneration|dest=${destinationKey.orEmpty()}")
    }

    data class Token(
