    )

    data class RawObservation(
        val snapshot: Snapshot,
        val leaseOpened: Boolean,
        val reason: String,
    )

    data class CandidateDecision(
        val snapshot: Snapshot,
        val token: Token,
        val firstBind: Boolean,
        val leaseTransition: Boolean,
        val sameDestination: Boolean,
        val reason: String,
    )

    private data class MutableLease(
        val leaseId: Long,
        val activationGeneration: Long,
        var rawRevision: Long = 0L,
        var destinationKey: String? = null,
        var addressSignatureKey: String? = null,
        var candidateSource: String? = null,
        var lastCandidateRawRevision: Long = -1L,
    )

    class Authority {
        private var serial = 0L
        private var current: MutableLease? = null

        @Synchronized
        fun observeRawEvent(activationGeneration: Long): RawObservation {
            val existing = current
            val opened = existing == null || existing.activationGeneration != activationGeneration
            val lease = if (opened) newLeaseLocked(activationGeneration) else existing!!
            lease.rawRevision += 1L
            Metrics.increment("rawEvents")
            if (opened) Metrics.increment("leasesOpened")
            val snapshot = snapshotLocked(lease)
            Metrics.updateLease(snapshot)
            return RawObservation(
                snapshot,
                leaseOpened = opened,
                reason = if (opened) "activation_session_lease_opened" else "raw_event_provenance_only",
            )
        }

